# Управление пользователями в Linux
## Выполнил: Ивкин Дмитрий

## 1) Добавление пользователей user1 и user2:
# Создание user1 с оболочкой bash
sudo useradd -m -s /bin/bash user1

# Создание user2 с оболочкой sh (более легковесная оболочка)
sudo useradd -m -s /bin/sh user2

# Установка паролей для созданных пользователей
echo "user1:password123" | sudo chpasswd
echo "user2:password456" | sudo chpasswd

# Проверка корректности создания пользователей
id user1
id user2
cat /etc/passwd | grep -E "user1|user2"

## 2) Назначение групп пользователям:
# Добавление user1 в группу администраторов (sudo или wheel)
sudo usermod -aG sudo user1  # Для Debian/Ubuntu
# ИЛИ sudo usermod -aG wheel user1 # Для CentOS/RHEL

# Создание группы user1 (если не создана автоматически) и добавление в нее user2
sudo groupadd user1_group 2>/dev/null || true
sudo usermod -aG user1_group user2
sudo usermod -aG user1_group user1

# Проверка назначенных групп
groups user1
groups user2
getent group sudo
getent group user1_group

## 3) Права доступа к файлам:
# Права доступа определяют, кто может читать (r), записывать (w) и выполнять (x) файлы
# Формат вывода: -rwxr-xr-- 1 user1 group1 0 Dec 28 10:00 filename
# Первый символ: тип файла (- файл, d директория, l ссылка)
# Следующие 9 символов: права для владельца (3), группы (3), остальных (3)

# Просмотр прав доступа в домашней директории user1
ls -la /home/user1/ 2>/dev/null || echo "Директория не существует"

## 4) Изменение прав доступа и создание файла с полными правами:
# Команда chmod изменяет права доступа к файлам и директориям
# Цифровой формат: 777 = rwxrwxrwx (все права для всех)

# Создание и настройка файла с максимальными правами
sudo -u user1 bash -c "
cd /home/user1
echo 'Тестовый файл с полными правами доступа' > shared_file.txt
chmod 777 shared_file.txt
ls -l shared_file.txt
"

## 5) Учетная запись суперпользователя:
# В Linux встроенная учетная запись администратора называется "root"
# UID (User ID) root всегда равен 0

# Просмотр информации о root
echo "Имя суперпользователя: root"
echo "UID root: $(id -u root)"

## 6) Выполнение команд с правами администратора:
# sudo - выполнение одной команды с правами суперпользователя
# Пример:
sudo whoami
# Вывод: root

# su - - переключение в сеанс суперпользователя (требует пароль root)
# sudo -u user - выполнение от имени другого пользователя
sudo -u user1 whoami
# Вывод: user1

## 7) Ограничения суперпользователя:
# Хотя root имеет практически неограниченные права, существуют некоторые ограничения:

# 1. Атрибуты файлов (immutable flag) - пример
sudo touch /tmp/test_file.locked
sudo chattr +i /tmp/test_file.locked 2>/dev/null && echo "Файл защищен от изменений"

# 2. Read-only файловые системы
echo "Пример read-only системы: /boot, некоторые разделы recovery"

# 3. Загрузка модулей ядра может быть ограничена

## 8) Удаление пользователя user2 через user1:
# user1 должен иметь права sudo для удаления других пользователей

# Предварительная проверка
echo "Перед удалением:"
id user2 2>/dev/null || echo "user2 не существует"

# Удаление (если user1 имеет права sudo)
sudo userdel -r user2 2>/dev/null && echo "user2 удален" || echo "Не удалось удалить user2"

# Проверка
id user2 2>/dev/null && echo "user2 все еще существует" || echo "user2 успешно удален"

## 9) Изменение владельца файлов и директорий:
# Команда chown (change owner) изменяет владельца и группу файлов

# Меняем владельца файла созданного ранее
if [ -f /home/user1/shared_file.txt ]; then
    sudo chown user1:user1_group /home/user1/shared_file.txt
    echo "Владелец изменен:"
    ls -l /home/user1/shared_file.txt
else
    echo "Файл не найден, создаем новый..."
    sudo -u user1 touch /home/user1/test_file.txt
    sudo chown user1:user1_group /home/user1/test_file.txt
    ls -l /home/user1/test_file.txt
fi

# Дополнительно: создание директории и смена владельца
sudo -u user1 mkdir -p /home/user1/shared_folder
sudo chown user1:user1_group /home/user1/shared_folder
echo "Директория создана:"
ls -ld /home/user1/shared_folder

## 10) Проверка и очистка:
echo "=== Итоговая проверка ==="
echo "Существующие пользователи из нашей работы:"
getent passwd | grep -E "user1|root" || true
echo "Группы:"
getent group | grep -E "sudo|user1_group" || true

